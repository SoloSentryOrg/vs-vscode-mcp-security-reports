{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/SoloSentryOrg/vs-vscode-mcp-security-reports/blob/main/schemas/publication-bundle-v1.schema.json",
  "title": "SoloSentry public assessment publication bundle v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "request_id",
    "producer_revision",
    "consumer_repository",
    "report_file",
    "report"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "request_id": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]*/[0-9]{4}-[0-9]{2}-[0-9]{2}-v[0-9]+\\.[0-9]+$"
    },
    "producer_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "consumer_repository": {
      "const": "SoloSentryOrg/vs-vscode-mcp-security-reports"
    },
    "report_file": {
      "type": "string",
      "minLength": 6,
      "maxLength": 255,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]*\\.docx$"
    },
    "report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assessment",
        "target_version",
        "assessment_date",
        "report_version",
        "classification",
        "path",
        "sha256",
        "word_pages"
      ],
      "properties": {
        "assessment": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]*$"
        },
        "target_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9 ._()+-]*$"
        },
        "assessment_date": {
          "type": "string",
          "format": "date",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "report_version": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+$"
        },
        "classification": {
          "const": "PUBLIC"
        },
        "path": {
          "type": "string",
          "minLength": 15,
          "maxLength": 500,
          "pattern": "^reports/[A-Za-z0-9][A-Za-z0-9 ._()+-]*/[A-Za-z0-9][A-Za-z0-9 ._()+-]*\\.docx$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "word_pages": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
